# このファイルをコピーして、ボットごとに作る（どちらもGitHubには上がらない）
#   .env.report    … 日報ボット（LINE Developers → FunFirm、linebot@funfirm.jp）
#   .env.assistant … 管理ボット（LINE Developers → FunFirm_host、linebot2@funfirm.jp）
# 日報ボットは .env.report がなければ従来の .env を読む

# --- LINE（チャネル基本設定 → チャネルシークレット / Messaging API設定 → アクセストークン（長期））---
LINE_CHANNEL_SECRET=ここにチャネルシークレット
LINE_CHANNEL_ACCESS_TOKEN=ここにチャネルアクセストークン

# --- 保存先（2つのボットで同じ場所を指す）---
# local: このフォルダの data/ に保存（Macでのテスト）
# gcs:   Cloud Storage に保存（GCS_BUCKET が必要。gcloud auth application-default login 済みであること）
STORAGE_BACKEND=local
DATA_DIR=data
GCS_BUCKET=

# --- 管理ボットだけ: 使える管理者のユーザーID（カンマ区切り。空なら全員＝テスト用）---
# 管理ボットに「ID」と送ると返ってくる値を入れる
ALLOWED_USER_IDS=
